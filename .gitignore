# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd

# Virtual environments
venv/
.env/
.venv/

# Deploy settings (server host/path); copy .env.example to .env
.env

# Distribution / packaging
build/
dist/
*.egg-info/

# Logs
*.log
logs/

# OS files
.DS_Store
Thumbs.db

# IDEs
.vscode/
.idea/

# Local config (you may want to commit a template instead)
config.yaml

# Everything in data/ (credentials, tokens, SQLite state) except templates
data/*
!data/*.example.json
!data/.gitkeep

# Temp / cache
*.tmp
*.cache
tmp/

# Zip artifacts
*.zip
